# Origin of the FastAPI backend. Must be an origin that appears in the API's
# CORS_ORIGINS list, and must not have a trailing slash.
#
# Left unset, the app falls back to http://localhost:8000, which is what
# `uvicorn app.main:app --reload` serves - so for local development you do not
# need a .env file at all.
VITE_API_URL=http://localhost:8000
