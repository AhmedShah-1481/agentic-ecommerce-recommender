# ============================================================
# Copy to .env and fill in.  .env is gitignored - never commit it.
# ============================================================

# ---- App ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db

# ---- Gemini (MANDATORY: all LLM + embedding calls go through Gemini) ----
# Get a key at https://aistudio.google.com/apikey. With this blank the app still
# boots and every page works - the agent degrades to behavioural retrieval and
# mechanical copy, and embeddings fall back to a local deterministic embedder.
GEMINI_API_KEY=
# 2.5-era models are no longer served to new API keys - they 404 with a pointer
# to the current one. Both generations work: the client asks for minimal hidden
# reasoning on JSON calls, which 2.5 spells `thinking_budget` and 3.x spells
# `thinking_level`, and corrects itself if the model rejects its first guess.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_ENABLED=true
# gemini-embedding-001 is natively 3072-dim and supports Matryoshka truncation
# to 768 or 1536. Chroma pins a collection's dimensionality at its first insert,
# so changing this drops and rebuilds the vector collection on the next
# reconcile (SQL is untouched; the vectors are a derived index).
GEMINI_EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# ---- Vector store ----
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=products

# ---- Recommendation engine tuning (LLM-call efficiency) ----
# REC_COOLDOWN_MINUTES is checked BEFORE the momentum and novelty gates, so
# nothing regenerates inside the window - not even an add-to-cart. That is the
# point in production; when demoing the system live, set it to 1 so behaviour
# changes are visible in seconds, then put it back.
REC_COOLDOWN_MINUTES=10          # min gap between generations per user
REC_MIN_EVENTS=8                 # events needed to justify a regeneration
REC_TTL_HOURS=12                 # recommendation freshness window
REC_MIN_SIGNAL_EVENTS=3          # below this -> cold start, zero LLM spend
REC_MAX_ITEMS=4

# ---- Scheduler (bonus) ----
SCHEDULER_ENABLED=true
DIGEST_HOUR=16                   # UTC
DIGEST_MINUTE=0
RECONCILE_MINUTES=5              # SQL <-> vector drift repair interval
EVENT_RETENTION_DAYS=30
BASE_URL=http://127.0.0.1:8000   # absolute origin of THIS api, for admin links

# ---- Storefront (React + Vite) ----
# Where the customer-facing app is served from. Customer links in the digest
# email point here, not at BASE_URL: /product/{id} on the API is JSON now and
# /for-you exists only in the React router.
STOREFRONT_URL=http://localhost:5173
# Browser origins allowed to call the API. Comma-separated, and never "*" - the
# storefront sends the session cookie, so the middleware runs with
# allow_credentials=True and a wildcard origin is rejected by the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email delivery (bonus) ----
EMAIL_BACKEND=outbox             # outbox | smtp
EMAIL_FROM=recommendations@bazario.dev
OUTBOX_DIR=./outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Product imagery ----
# Only needed to re-run scripts/fetch_images.py, which sources product photos
# from Unsplash. The URLs it finds are committed to seed/products.json, so a
# fresh clone renders photographs without setting this at all. Free key from
# https://unsplash.com/developers (demo tier: 50 requests/hour, which covers a
# full catalog pass). Leave blank and products fall back to generated panels.
UNSPLASH_ACCESS_KEY=

# ---- Observability (bonus) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bazario-agent
