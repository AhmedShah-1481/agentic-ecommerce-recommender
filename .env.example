# ============================================================
# Copy to .env and fill in.  .env is gitignored - never commit it.
# ============================================================

# ---- App ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db

# ---- Mesh API (MANDATORY: all LLM + embedding calls go through Mesh) ----
# Mesh is OpenAI-compatible; driven via the openai SDK pointed at this base URL.
MESH_API_BASE_URL=https://api.meshapi.ai/v1
MESH_API_KEY=
MESH_CHAT_MODEL=tencent/hy3
# Embeddings may not be offered for every Mesh model. If the endpoint is
# unavailable the app automatically falls back to a local deterministic
# embedder, so retrieval keeps working either way.
MESH_EMBED_MODEL=openai/text-embedding-3-small
MESH_EMBED_ENABLED=true
MESH_TIMEOUT_SECONDS=120
MESH_MAX_RETRIES=2

# ---- Vector store ----
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=products

# ---- Recommendation engine tuning (LLM-call efficiency) ----
# REC_COOLDOWN_MINUTES is checked BEFORE the momentum and novelty gates, so
# nothing regenerates inside the window - not even an add-to-cart. That is the
# point in production; when demoing the system live, set it to 1 so behaviour
# changes are visible in seconds, then put it back.
REC_COOLDOWN_MINUTES=10          # min gap between generations per user
REC_MIN_EVENTS=8                 # events needed to justify a regeneration
REC_TTL_HOURS=12                 # recommendation freshness window
REC_MIN_SIGNAL_EVENTS=3          # below this -> cold start, zero LLM spend
REC_MAX_ITEMS=4

# ---- Scheduler (bonus) ----
SCHEDULER_ENABLED=true
DIGEST_HOUR=16                   # UTC
DIGEST_MINUTE=0
RECONCILE_MINUTES=5              # SQL <-> vector drift repair interval
EVENT_RETENTION_DAYS=30
BASE_URL=http://127.0.0.1:8000   # absolute origin for links in emails

# ---- Email delivery (bonus) ----
EMAIL_BACKEND=outbox             # outbox | smtp
EMAIL_FROM=recommendations@learnloop.dev
OUTBOX_DIR=./outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Observability (bonus) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=learnloop-agent
